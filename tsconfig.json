{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "outDir": "dist-server", "rootDir": "src",
    "lib": ["ES2023", "DOM"], "types": ["node"], "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
